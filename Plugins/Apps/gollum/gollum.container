[Unit]
Description=gollum container
After=local-fs.target

[Container]
ContainerName=gollum
Image=docker.io/gollumwiki/gollum:master
Exec=--config=/config/config.rb
PublishPort=0.0.0.0:14567:4567
UserNS=keep-id:uid=1000,gid=1000
Volume=/srv/gollum/repo:/wiki:Z
Volume=/srv/gollum/config:/config:Z
LogDriver=journald
AutoUpdate=registry

[Service]
TimeoutStartSec=6min
Restart=on-failure

[Install]
WantedBy=multi-user.target default.target
