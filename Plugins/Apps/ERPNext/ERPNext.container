
[Unit]
Description=ERPNext container
After=local-fs.target

[Container]
ContainerName=ERPNext
Image=ConfigLM.moe/erpnext:v$VERSION
EnvironmentFile=/var/lib/erpnext/.config/containers/systemd/ERPNext.env
Network=ERPNext.network
AddHost=$PUBLIC_HOST:169.254.1.2
IP=10.90.50.10
HostName=ERPNext
UserNS=keep-id:uid=1000,gid=1000
Volume=/var/lib/erpnext/sites:/home/frappe/frappe-bench/sites:z
Volume=/var/lib/erpnext/logs:/home/frappe/frappe-bench/logs:z
Volume=/var/lib/erpnext/config:/home/frappe/frappe-bench/config:z
LogDriver=journald

[Service]
TimeoutStartSec=12min
Restart=on-failure
RestartSteps=10
RestartMaxDelaySec=30m

[Install]
WantedBy=multi-user.target default.target
